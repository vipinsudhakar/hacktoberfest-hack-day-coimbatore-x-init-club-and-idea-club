# Free key from https://aistudio.google.com/apikey — put the real value in .env.local (never commit it).
# Several keys separated by commas are used in rotation, which spreads the free-tier rate limits.
GEMINI_API_KEY=

# Gemma 4 model served through the Gemini API (gemma-4-26b-a4b-it is faster, gemma-4-31b-it is stronger)
GEMMA_MODEL=gemma-4-26b-a4b-it
